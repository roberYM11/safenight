SAFENIGHT_DATABASE_URL=postgresql+asyncpg://safenight:change-me@127.0.0.1:5432/safenight
SAFENIGHT_DB_PASSWORD=change-me-for-compose
SAFENIGHT_SDOT_API_KEY=
SAFENIGHT_CCTV_API_KEY=
SAFENIGHT_COLLECTION_HOUR=3
SAFENIGHT_COLLECTION_MINUTE=0
SAFENIGHT_CORRECTION_DAYS=7
SAFENIGHT_MAX_PAGES=10000
SAFENIGHT_SENSOR_LOCATIONS_FILE=var/sensor_locations.xlsx
SAFENIGHT_MODEL_BUNDLE_DIR=var/models/random_forest
SAFENIGHT_WEB_DIST=../work/safenight/dist
SAFENIGHT_NEARBY_PROVIDER_ENABLED=true
