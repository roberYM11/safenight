{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "vite.config.ts",
    "pages/SafetyMap.tsx",
    "components/SensorMap.tsx",
    "components/Safety*.tsx",
    "utils/api.ts",
    "utils/useSafetyData.ts",
    "utils/format.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
